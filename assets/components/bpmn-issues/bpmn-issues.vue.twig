{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/message') -}}
{%- endblock -%}

{%- block vue_config -%}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyBpmnDsBundle.components.bpmn-issues.bpmn-issues::*') }}
{%- endblock -%}

{%- block vue_body -%}
    <div class="bpmn-issues">
        <message v-if="!isLoading && !entities.length" type="success" compact :title="t('valid')"></message>
        <message v-for="issue in entities"
                 :key="issue.id"
                 :type="messageType(issue)"
                 compact
                 :title="messageTitle(issue)"></message>
    </div>
{%- endblock -%}
