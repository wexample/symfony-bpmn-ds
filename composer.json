{
  "name": "wexample/symfony-bpmn-ds",
  "version": "2.0.6",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyBpmnDs\\": "src/"
    }
  },
  "description": "The interface of symfony-bpmn: a process drawn, walked, its rights and its validation",
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyBpmnDs\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=18.0.0",
    "wexample/symfony-loader": ">=24.0.0",
    "wexample/symfony-design-system": ">=39.0.0",
    "wexample/symfony-api": ">=14.0.0",
    "wexample/symfony-bpmn": ">=3.0.0",
    "wexample/symfony-stage": ">=2.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}