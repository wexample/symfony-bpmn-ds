{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}
{%- set page_title = process.name ?: process.processId -%}
{#- The process is the whole of the page, edge to edge: its title, then its
    diagram and its inspector standing apart on the page's ground. -#}
{%- set page_zone_flush = true -%}
{%- set page_zone_plain = true -%}

{%- block page_body -%}
    <div class="page--fill">
        {{ vue(render_pass, '@WexampleSymfonyBpmnDsBundle/components/bpmn-process', {
            process: process.processId,
            documentation: process.documentation,
        }) }}
    </div>
{%- endblock -%}
