{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyStageBundle/components/stage') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyStageBundle/components/stage-links') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyStageBundle/components/stage-regions') -}}
{%- endblock -%}

{%- block vue_config -%}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyBpmnDsBundle.components.bpmn-diagram.bpmn-diagram::*') }}
{%- endblock -%}

{%- block vue_body -%}
    <div class="bpmn-diagram" :class="{ 'bpmn-diagram--fill': fill }" :style="{ '--bpmn-diagram-height': height + 'px' }" :aria-busy="loading ? 'true' : 'false'">
        <p v-if="failed" class="fallback">[[ t('failed') ]]</p>
        <stage
                v-else
                :axis="fill ? 'both' : 'x'"
                readonly
                bounded
                :grid="0"
                :label="t('label')"
                :elements="elements"
                :highlighted="highlighted"
                @update:selection="(value) => $emit('update:selection', value)"
        >
            {#- Its lanes under it, its flows between its nodes: layers of the stage. -#}
            <template #layers>
                <stage-regions :regions="regions"></stage-regions>
                <stage-links :links="links"></stage-links>
            </template>
            {#- Each node drawn with the figures of the stage: a box for what is
                done, a circle for an event, a diamond for a choice. -#}
            <template #element="{ element }">
                <div v-if="element.kind === 'task' || element.kind === 'activity'"
                     class="block stage-shape stage-shape--box"
                     :class="shapeClass(element)"
                     :title="nodeLabel(element)">
                    <span v-if="nodeIcon(element)" class="block--mark" aria-hidden="true" v-html="renderIcon(nodeIcon(element))"></span>
                    <span class="stage-shape--label">[[ element.title ]]</span>
                </div>
                <div v-else
                     class="stage-shape"
                     :class="shapeClass(element)"
                     :title="nodeLabel(element)">
                    <span class="stage-shape--figure">
                        <span v-if="nodeIcon(element)" class="stage-shape--glyph" aria-hidden="true" v-html="renderIcon(nodeIcon(element))"></span>
                    </span>
                    <span v-if="element.title" class="stage-shape--caption">[[ element.title ]]</span>
                </div>
            </template>
        </stage>
    </div>
{%- endblock -%}
