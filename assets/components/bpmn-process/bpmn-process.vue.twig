{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/properties') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/tab') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/zone-resizer') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyBpmnDsBundle/components/bpmn-diagram') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyBpmnDsBundle/components/bpmn-issues') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyBpmnDsBundle/components/bpmn-path-walk') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyBpmnDsBundle/components/bpmn-rights-table') -}}
{%- endblock -%}

{%- block vue_config -%}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyBpmnDsBundle.components.bpmn-process.bpmn-process::*') }}
{%- endblock -%}

{%- block vue_body -%}
    <div class="zone zone--split bpmn-process">
        {#- The diagram: what is left of the width, and the whole height. -#}
        <div class="zone zone--panel bpmn-process--stage">
            <bpmn-diagram
                    fill
                    :process="process"
                    :highlighted="tab === 'paths' ? highlighted : []"
                    @loaded="onLoaded"
                    @update:selection="(value) => selection = value"
            ></bpmn-diagram>
        </div>

        {#- The inspector, against the right edge: widened from its inner edge,
            what the process is in one tab, its paths in the other, each kept
            alive while the other is shown — a path walked stays walked. -#}
        <div class="zone zone--narrow zone--size-7 zone--panel zone--split zone--split--vertical bpmn-process--aside"
             :data-zone-id="asideZone"
             :style="asideStyle">
            <zone-resizer edge="start"></zone-resizer>
            <div class="zone zone--narrow">
                <tab :items="tabs" :active-key="tab" fill compact @change="onTab"></tab>
            </div>
            {#- Each tool its own region under the tabs: the description
                scrolls whole, the paths keep their bar against the tabs. -#}
            <div v-show="tab === 'description'" class="zone zone--scrollable">
                <div class="zone--content stack--vertical">
                    <p v-if="documentation">[[ documentation ]]</p>
                    <h3>[[ t('step.title') ]]</h3>
                    <properties v-if="picked" :items="pickedProperties" stacked></properties>
                    <p v-else class="fallback">[[ t('step.none') ]]</p>
                    <h3>[[ t('actors') ]]</h3>
                    <bpmn-rights-table :filters="{ process: process }"></bpmn-rights-table>
                    <h3>[[ t('validation') ]]</h3>
                    <bpmn-issues :process="process"></bpmn-issues>
                </div>
            </div>
            <bpmn-path-walk
                    v-show="tab === 'paths'"
                    class="zone--joined-start"
                    :process="process"
                    :lanes="lanes"
                    @update:highlighted="(value) => highlighted = value"
            ></bpmn-path-walk>
        </div>
    </div>
{%- endblock -%}
